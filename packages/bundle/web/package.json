{
  "name": "@maota/web-bundle",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "maota": {
    "bundle": {
      "patch": "./patch.toml",
      "protocol": 3
    }
  },
  "types": "lib/index.d.ts",
  "dependencies": {
    "@maota/web": "workspace:*"
  },
  "peerDependencies": {
    "@maota/plugin-kit": "^0.1.0"
  },
  "devDependencies": {
    "@maota/plugin-kit": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "patch.toml"
  ]
}
